// ============================================
// 1. VARIABLES DE COLORES
// ============================================
@wall-color: #f5deb3;      // Color de paredes (beige)
@roof-color: #8b4513;      // Color del techo (marrón)
@door-color: #6b3e1b;      // Color de la puerta (marrón oscuro)
@window-color: #87ceeb;    // Color de ventanas (celeste)
@window-frame: #ffffff;    // Marco de ventana (blanco)
@door-knob: #ffd700;       // Pomo de la puerta (dorado)

// ============================================
// 2. VARIABLES DE TAMAÑOS
// ============================================
@house-width: 300px;
@house-height: 250px;
@roof-height: 120px;
@window-size: 50px;
@door-width: 60px;
@door-height: 90px;

// ============================================
// 3. MIXIN para ventanas
// ============================================
.window-styles() {
    width: @window-size;
    height: @window-size;
    background-color: @window-color;
    border: 4px solid @window-frame;
    border-radius: 5px;
    position: absolute;
    top: 30px;
    
    // Cruz de la ventana (vidrios)
    &::before {
        content: '';
        position: absolute;
        width: 100%;
        height: 2px;
        background-color: @window-frame;
        top: 50%;
        left: 0;
        transform: translateY(-50%);
    }
    
    &::after {
        content: '';
        position: absolute;
        width: 2px;
        height: 100%;
        background-color: @window-frame;
        left: 50%;
        top: 0;
        transform: translateX(-50%);
    }
}

// ============================================
// 4. ESTILOS PRINCIPALES (con anidación)
// ============================================
body {
    margin: 0;
    padding: 0;
    background: linear-gradient(135deg, #87ceeb 0%, #98d8c8 100%);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Arial, sans-serif;
}

.container {
    display: flex;
    justify-content: center;
    align-items: center;
}

// CLASE PRINCIPAL DE LA CASA
.house {
    position: relative;
    width: @house-width;
    
    // ============================================
    // TECHO
    // ============================================
    &__roof {
        width: 0;
        height: 0;
        border-left: (@house-width / 2) solid transparent;
        border-right: (@house-width / 2) solid transparent;
        border-bottom: @roof-height solid @roof-color;
        position: relative;
        z-index: 1;
        
        // Chimenea opcional (detalle extra)
        &::before {
            content: '';
            position: absolute;
            width: 30px;
            height: 50px;
            background-color: #a0522d;
            bottom: -10px;
            right: -40px;
        }
    }
    
    // ============================================
    // PAREDES
    // ============================================
    &__walls {
        position: relative;
        width: @house-width;
        height: @house-height;
        background-color: @wall-color;
        border: 2px solid #8b7355;
        margin-top: -2px;
        
        // ========================================
        // VENTANAS (usando el mixin)
        // ========================================
        &__window {
            .window-styles();
            
            // Ventana izquierda
            &--left {
                left: 30px;
            }
            
            // Ventana derecha
            &--right {
                right: 30px;
            }
        }
        
        // ========================================
        // PUERTA
        // ========================================
        &__door {
            width: @door-width;
            height: @door-height;
            background-color: @door-color;
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            border-radius: 5px 5px 0 0;
            border: 2px solid #4a2a0e;
            
            // Pomo de la puerta
            &::before {
                content: '';
                position: absolute;
                width: 8px;
                height: 8px;
                background-color: @door-knob;
                border-radius: 50%;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
            }
        }
    }
}

