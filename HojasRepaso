// ============================================
// 1. VARIABLES
// ============================================
// Colores
$color-success: #2ecc71;  // Verde éxito
$color-warning: #f1c40f;  // Amarillo advertencia
$color-error: #e74c3c;    // Rojo error

// Tipografía
$font-family: 'Arial', sans-serif;
$font-size-base: 14px;
$font-size-title: 24px;

// Márgenes y tamaños
$margin-bottom: 15px;
$padding-notification: 15px;
$border-radius: 10px;
$icon-size: 24px;

// ============================================
// 2. MIXIN para notificaciones
// ============================================
@mixin notification-styles($bg-color, $border-color) {
    background-color: $bg-color;
    border-left: 5px solid $border-color;
    border-radius: $border-radius;
    padding: $padding-notification;
    margin-bottom: $margin-bottom;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    animation: slideIn 0.4s ease-out;
}

// ============================================
// 3. ANIMACIÓN
// ============================================
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

// ============================================
// 4. ESTILOS PRINCIPALES (con anidación)
// ============================================
body {
    font-family: $font-family;
    background-color: #f4f4f4;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    padding: 20px;
}

.notifications-container {
    max-width: 500px;
    width: 100%;
    
    h1 {
        font-size: $font-size-title;
        color: #333;
        margin-bottom: 25px;
        text-align: center;
    }
}

// Clase base de notificación con anidación
.notification {
    // Anidación del icono
    &__icon {
        font-size: $icon-size;
        flex-shrink: 0;
    }
    
    // Anidación del texto
    &__text {
        font-size: $font-size-base;
        margin: 0;
        flex: 1;
        color: #333;
    }
    
    // Variantes usando el mixin
    &--success {
        @include notification-styles(#d5f5e3, $color-success);
    }
    
    &--warning {
        @include notification-styles(#fef9e7, $color-warning);
    }
    
    &--error {
        @include notification-styles(#fadbd8, $color-error);
    }
}

