// IMPORTAR MÓDULOS
@import "variables.less";
@import "mixins.less";
@import "header.less";
@import "footer.less";

// GUARD SELECTORS para botones
.button-variant(@type) when (@type = primary) {
    background-color: @primary;
    &:hover { background-color: darken(@primary, 10%); }
}

.button-variant(@type) when (@type = secondary) {
    background-color: @secondary;
    &:hover { background-color: lighten(@secondary, 20%); }
}

.button-variant(@type) when (@type = danger) {
    background-color: @danger;
    &:hover { background-color: darken(@danger, 10%); }
}

