</html>

// 1. Variables
@primary-color: #3498db;
@secondary-color: #2ecc71;
@danger-color: #e74c3c;
@warning-color: #f39c12;
@text-dark: #2c3e50;
@text-light: #7f8c8d;
@bg-dashboard: #ecf0f1;
@white: #ffffff;
@font-family: 'Arial', sans-serif;
@base-padding: 20px;
@base-margin: 15px;
@card-radius: 12px;

// 2. Mixins
// Mixin para bordes redondeados
.bordered-radius(@radius: @card-radius) {
    border-radius: @radius;
}

// Mixin para sombras
.box-shadow(@x: 0px, @y: 4px, @blur: 12px, @color: rgba(0, 0, 0, 0.1)) {
    box-shadow: @x @y @blur @color;
}

// Mixin base para tarjetas
.card-base() {
    background-color: @white;
    padding: @base-padding;
    .bordered-radius();
    .box-shadow();
    transition: transform 0.3s ease;

    &:hover {
        transform: translateY(-5px);
    }
}

// 3. Guard para tarjetas
.card-variant(@type) when (@type = primary) {
    border-left: 4px solid @primary-color;
    
    .card-icon {
        color: @primary-color;
    }
    
    .card-value {
        color: @primary-color;
    }
}

.card-variant(@type) when (@type = secondary) {
    border-left: 4px solid @secondary-color;
    
    .card-icon {
        color: @secondary-color;
    }
    
    .card-value {
        color: @secondary-color;
    }
}

.card-variant(@type) when (@type = danger) {
    border-left: 4px solid @danger-color;
    
    .card-icon {
        color: @danger-color;
    }
    
    .card-value {
        color: @danger-color;
    }
}

.card-variant(@type) when (@type = warning) {
    border-left: 4px solid @warning-color;
    
    .card-icon {
        color: @warning-color;
    }
    
    .card-value {
        color: @warning-color;
    }
}

// 4. Estilos para dashborad
.dashboard {
    max-width: 1200px;
    margin: 0 auto;
    padding: @base-padding;
    font-family: @font-family;
}

// Encabezado del Dashboard
.dashboard-header {
    text-align: center;
    margin-bottom: @base-margin * 2;
    padding-bottom: @base-padding;
    border-bottom: 2px solid @primary-color;

    .dashboard-title {
        font-size: 32px;
        color: @text-dark;
        margin: 0 0 10px 0;
        
        &::before {
            content: "📊 ";
        }
    }

    .dashboard-subtitle {
        font-size: 14px;
        color: @text-light;
        margin: 0;
    }
}

// Grid de tarjetas
.stats-grid {
    display: flex;
    flex-wrap: wrap;
    gap: @base-margin * 1.5;
    justify-content: center;
}

// Tarjeta de estadísticas (clase base)
.stat-card {
    .card-base();
    width: 250px;
    text-align: center;
    transition: all 0.3s ease;

    // Nesting de elementos internos
    .card-icon {
        font-size: 48px;
        margin-bottom: @base-margin;
        display: inline-block;
    }

    .card-value {
        font-size: 36px;
        font-weight: bold;
        margin: @base-margin 0;
    }

    .card-label {
        font-size: 14px;
        color: @text-light;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0;
    }

    .card-trend {
        font-size: 12px;
        margin-top: @base-margin;
        padding-top: @base-margin / 2;
        border-top: 1px solid #eee;
        
        &.trend-up {
            color: @secondary-color;
            
            &::before {
                content: "▲ ";
            }
        }
        
        &.trend-down {
            color: @danger-color;
            
            &::before {
                content: "▼ ";
            }
        }
    }
}

// Aplicación de variantes a las tarjetas
.stat-card {
    &.primary {
        .card-variant(primary);
    }
    
    &.secondary {
        .card-variant(secondary);
    }
    
    &.danger {
        .card-variant(danger);
    }
    
    &.warning {
        .card-variant(warning);
    }
}

// 5. Estilos generales
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: @bg-dashboard;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}




