// 1. Definición de Variables
@primary-color: #3498db;
@secondary-color: #2ec071;
@alert-color: #e74c3c;
@font-family: 'Arial', sans-serif;
@font-size: 16px;

// 2. Definición de Mixins

.bordered-radius(@radius: 5px) {
    border-radius: @radius;
}


.box-shadow(@x: 0px, @y: 2px, @blur: 10px, @color: rgba(0, 0, 0, 0.15)) {
    box-shadow: @x @y @blur @color;
}

// 3. Estilizar Botón y Alerta utilizando Mixins y Variables
.button {
    background-color: @primary-color;
    color: white;
    font-family: @font-family;
    font-size: @font-size;
    padding: 10px 20px;
    cursor: pointer;
    .bordered-radius(8px); 
    .box-shadow(0px, 4px, 8px, rgba(0, 0, 0, 0.2)); 

    &:hover {
        background-color: darken(@primary-color, 10%);
    }
}

.alert-box {
    background-color: @alert-color;
    color: white;
    font-family: @font-family;
    font-size: @font-size;
    padding: 15px;
    .bordered-radius(); 
    .box-shadow(); 
}

