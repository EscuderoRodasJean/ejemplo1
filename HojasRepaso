<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ejercicio Less: Variables y Mixins</title>
    <link rel="stylesheet" href="css/styles.css">
    <style>
        body{
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        .container{
            display: flex;
            flex-direction: column;
            gap: 20px;
            align-items: start;
        }


    </style>
</head>
<body>
    <div class="container">
        <button class="button">Click Me</button>
        <div class="alert-box">!Este es un mensaje de alerta!</div>

    </div>


</body>
