Crea un sistema de botones que cambie de estilo basado en el tipo de boton primary secondary danger con guard selectors

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ejercicio Less: Guard Selectors</title>
    <link rel="stylesheet" href="css/styles.css">
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: #f4f4f4;
            gap: 10px;
            font-family: Arial, sans-serif;
            margin: 0;
        }
    </style>
</head>
<body>
    <button class="button primary">Primary Button</button>
    <button class="button secondary">Secondary Button</button>
    <button class="button danger">Danger Button</button>
</body>
</html>

// Variables de color
@primary-color: #3498db;
@secondary-color: #2ecc71;
@danger-color: #e74c3c;
@text-color: #ffffff;

// Mixin para estilos de botón base
.button-base() {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    color: @text-color;
    font-size: 14px;
    cursor: pointer;
    transition: background-color 0.3s;
}

// Mixin con guard selectors para aplicar estilos condicionales
.button-variant(@type) when (@type = primary) {
    background-color: @primary-color;

    &:hover {
        background-color: darken(@primary-color, 10%);
    }
}

.button-variant(@type) when (@type = danger) {
    background-color: @danger-color;

    &:hover {
        background-color: darken(@danger-color, 10%);
    }
}

.button-variant(@type) when (@type = primary) {
    background-color: @primary-color;

    &:hover {
        background-color: darken(@primary-color, 10%);
    }
}

.button-variant(@type) when (@type = secondary) {
    background-color: @secondary-color;

    &:hover {
        background-color: darken(@secondary-color, 10%);
    }
}

// Aplicación de mixins para cada botón
.button {
    .button-base(); // Aplicar estilos base

    &.primary {
        .button-variant(primary);
    }

    &.secondary {
        .button-variant(secondary);
    }

    &.danger {
        .button-variant(danger);
    }
}

